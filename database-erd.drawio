  <diagram id="gatrh-3nf" name="GATRH 3NF ERD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="GATRH — Normalized Database ERD (3NF target)&#xa;PK = Primary Key · FK = Foreign Key · UQ = Unique" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="60" as="geometry"/></mxCell>
        <mxCell id="note" value="Normalization choices: student and user program membership use program_id; schedule days are rows; draft entries are atomic rows. JSON snapshots and polymorphic audit targets are retained as history/audit payloads." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1400" height="55" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;name&lt;br&gt;email UQ&lt;br&gt;password_hash&lt;br&gt;role&lt;br&gt;contact_number&lt;br&gt;is_active&lt;br&gt;created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="50" y="190" width="220" height="210" as="geometry"/></mxCell>
        <mxCell id="programs" value="&lt;b&gt;PROGRAMS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;code UQ&lt;br&gt;name UQ&lt;br&gt;max_year_level&lt;br&gt;is_active&lt;br&gt;created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="370" y="190" width="220" height="175" as="geometry"/></mxCell>
        <mxCell id="user_program" value="&lt;b&gt;USER_PROGRAM&lt;/b&gt;&lt;hr&gt;PK, FK user_id&lt;br&gt;PK, FK program_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="370" y="410" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="students" value="&lt;b&gt;STUDENTS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK program_id&lt;br&gt;name&lt;br&gt;year_level&lt;br&gt;is_active&lt;br&gt;inactive_reason&lt;br&gt;created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="700" y="190" width="230" height="190" as="geometry"/></mxCell>
        <mxCell id="attendance" value="&lt;b&gt;ATTENDANCE_RECORDS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK student_id&lt;br&gt;FK submitted_by → users.id&lt;br&gt;FK validated_by → users.id NULL&lt;br&gt;gathering_type, day, batch, venue&lt;br&gt;status, validation_status&lt;br&gt;approved_at, rejection_reason&lt;br&gt;reporting_day, program/year snapshots&lt;br&gt;UNIQUE(student_id, gathering_type, day)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=12" vertex="1" parent="1"><mxGeometry x="1040" y="170" width="310" height="280" as="geometry"/></mxCell>
        <mxCell id="escalations" value="&lt;b&gt;ESCALATIONS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK student_id UQ&lt;br&gt;no_response_count&lt;br&gt;escalation_level&lt;br&gt;last_flagged_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="700" y="430" width="230" height="145" as="geometry"/></mxCell>
        <mxCell id="drafts" value="&lt;b&gt;ATTENDANCE_DRAFTS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK user_id&lt;br&gt;raw_text&lt;br&gt;status, gathering_type, day&lt;br&gt;unsubmitted_at&lt;br&gt;created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="50" y="500" width="230" height="160" as="geometry"/></mxCell>
        <mxCell id="draft_items" value="&lt;b&gt;ATTENDANCE_DRAFT_ITEMS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK draft_id&lt;br&gt;FK student_id NULL&lt;br&gt;raw_name&lt;br&gt;parsed_status&lt;br&gt;match_state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="370" y="560" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="reminders" value="&lt;b&gt;REMINDERS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK user_id&lt;br&gt;FK parent_reminder_id NULL&lt;br&gt;title, description&lt;br&gt;reminder_type, due_date, status&lt;br&gt;completed_at, expired_at&lt;br&gt;created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="50" y="750" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="monthly" value="&lt;b&gt;MONTHLY_EXPORT_TASKS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK user_id&lt;br&gt;FK reminder_id NULL&lt;br&gt;program, year_level, month&lt;br&gt;export/download approvals + hashes&lt;br&gt;UNIQUE(user_id, program, year_level, month)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacing=8;fontSize=12" vertex="1" parent="1"><mxGeometry x="370" y="780" width="270" height="175" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;AUDIT_LOGS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK actor_id → users.id&lt;br&gt;action&lt;br&gt;target_type, target_id* &lt;br&gt;result, details&lt;br&gt;created_at, updated_at&lt;br&gt;*polymorphic reference, no FK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="700" y="680" width="240" height="175" as="geometry"/></mxCell>
        <mxCell id="settings" value="&lt;b&gt;SYSTEM_SETTINGS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;institution_name&lt;br&gt;academic_year&lt;br&gt;timezone, date_format&lt;br&gt;FK updated_by → users.id NULL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="rollovers" value="&lt;b&gt;SCHOOL_YEAR_ROLLOVERS&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;school_year UQ&lt;br&gt;promotion/graduation counts&lt;br&gt;FK performed_by → users.id NULL&lt;br&gt;undo_snapshot JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="1040" y="730" width="260" height="155" as="geometry"/></mxCell>
